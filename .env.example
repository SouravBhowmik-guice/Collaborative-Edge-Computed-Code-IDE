# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ide

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# pgvector (PostgreSQL with pgvector extension for RAG)
PGVECTOR_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/ide

# JWT Secret (shared between Node and Python services)
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Server
NODE_ENV=development
PORT=3001
AI_PORT=8000

# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_URL=http://localhost:3001
VITE_AI_API_URL=http://localhost:8000

# Wasm
WASM_MEMORY_LIMIT_MB=128
WASM_TIME_LIMIT_MS=5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_WASM=true
ENABLE_MULTIPLAYER=true
ENABLE_AI=true
ENABLE_CANVAS=false
ENABLE_RAG=true
DEBUG=false